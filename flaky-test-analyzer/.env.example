APP_ENV=development
PORT=8000
# Optional. Leave blank to use deterministic analysis only. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MAX_UPLOAD_MB=10
MAX_TRACE_UPLOAD_MB=50
MAX_AI_TESTS_PER_REQUEST=5
# Maximum characters retained in each individual evidence text field.
AI_MAX_TEXT_CHARS=12000
# Privacy-first product validation analytics. The admin token is independent of AI credentials.
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=data/analytics.db
ANALYTICS_RETENTION_DAYS=30
ANONYMOUS_SESSION_DAYS=30
ADMIN_METRICS_TOKEN=
